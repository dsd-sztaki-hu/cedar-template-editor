# Settings for the ARP Dataverse upgrade dry-run and post-check against the LIVE CEDAR.
#
#   cp tests/node/.env.example tests/node/.env
#   then fill in the values marked <...> and run:
#   npm run arp-upgrade:dry-run
#   npm run arp-upgrade:post-check -- --against tests/node/work/<timestamp>
#
# tests/node/.env is git-ignored. Never commit it, and never put the real API
# key into this .example file.
#
# Precedence: a command-line option (e.g. --domain) wins over a variable set in
# the shell, which wins over this file. Both scripts only send GET requests to
# CEDAR. They never change anything there.
#
# arp-upgrade:local-copy does NOT use this file. It only writes to a local
# CEDAR (*.orgx) and takes its key from LOCAL_CEDAR_API_KEY or --api-key.


# ---------- CEDAR ----------

# REQUIRED. The API key of the CEDAR Admin user on the live CEDAR.
# Find it in the live CEDAR UI: log in as CEDAR Admin, open the user menu,
# then "Profile", and copy the API key.
# It gives full access to CEDAR Admin's resources: keep it out of git, chats,
# tickets and screenshots. It is only sent to https://resource.<CEDAR_DOMAIN>
# and https://user.<CEDAR_DOMAIN>, and never written to the work folder.
CEDAR_API_KEY=<CEDAR Admin API key from the live CEDAR profile page>

# REQUIRED. Base domain of the live CEDAR. If the live CEDAR web app is at
# https://cedar.example.org, this is example.org: the scripts then call
# https://resource.example.org and https://user.example.org.
# The ids of live CEDAR resources show it too: https://repo.<CEDAR_DOMAIN>/templates/...
# (Not repo.researchdata.hu: that is the ARP Dataverse, not CEDAR.)
CEDAR_DOMAIN=schema.researchdata.hu

# The CEDAR user whose home folder holds Public/Dataverse and Versions/.
# This must also be the user who runs the upgrade in the UI,
# because the upgrade archives into the home folder of whoever runs it.
CEDAR_HOME_USER=CEDAR Admin


# ---------- The folder and the versions ----------

# The folder that is upgraded: a path below CEDAR_HOME_USER's home, or a folder @id.
ARP_UPGRADE_FOLDER=/Public/Dataverse

# The Dataverse version the folder is now. Live is still drafts, which are
# published as this version by the upgrade itself, before it makes the targets.
ARP_UPGRADE_FROM=6.9.0

# The Dataverse versions to upgrade to, oldest first, comma-separated.
# The same values go into the upgrade dialog in the CEDAR UI.
ARP_UPGRADE_TARGETS=6.10,6.11,6.12.1


# ---------- ARP (Dataverse) endpoints ----------

# The ARP TSV-to-CEDAR converter and template check the live CEDAR UI uses.
# Both work without authentication.
ARP_CONVERT_URL=https://repo.researchdata.hu/api/arp/convertTsvToCedarTemplate
ARP_CHECK_URL=https://repo.researchdata.hu/api/arp/checkCedarTemplate


# ---------- Only if needed ----------

# The live CEDAR has a valid certificate, so leave this unset. Only a local
# CEDAR with a self-signed certificate needs NODE_TLS_REJECT_UNAUTHORIZED=0,
# and that switches off certificate checks for every request the script makes.
# NODE_TLS_REJECT_UNAUTHORIZED=0
